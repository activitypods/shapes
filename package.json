{
  "name": "activitypods-shapes-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "website"
  ],
  "scripts": {
    "start": "node index.ts",
    "build": "lerna run build --scope=@activitypods/shape-definitions && lerna run build --scope=@activitypods/ldo-shapes && lerna exec -- yalc publish --push --changed",
    "preversion": "yarn build",
    "build:website": "yarn workspace @activitypods/shapes-website build",
    "dev:website": "yarn workspace @activitypods/shapes-website dev"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "dotenv": "^16.5.0",
    "express": "^4.18.2",
    "n3": "^1.25.2",
    "negotiator": "^1.0.0",
    "rdf-transform": "^1.0.0",
    "streamify-string": "^1.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/n3": "^1.21.1",
    "@types/negotiator": "^0.6.3",
    "@types/streamify-string": "^1.0.4",
    "lerna": "^8.2.2",
    "parcel": "^2.15.0",
    "typescript": "^5.8.3",
    "yalc": "^1.0.0-pre.53"
  },
  "engines": {
    "node": ">22.12.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
