# The base IRI passed to [rdf-parse](https://www.npmjs.com/package/rdf-parse), when the format is converted.
BASE_URL=
# The port to host the shapes from.
PORT=30916
# Public URL of this shape repository, used to build the absolute shape URIs shown on the website.
PUBLIC_URL=https://shapes.activitypods.org
# LDP container listing the applications trusted by ActivityPods (crawled to know which shapes they use).
TRUSTED_APPS_URL=https://activitypods.org/data/trusted-apps
# Milliseconds before the crawled applications are refreshed in the background.
APPLICATIONS_CACHE_TTL=3600000
# GitHub token used to open pull requests for shape proposals (fine-grained, contents + pull requests on the repository).
# Leave empty to disable the proposal form. Put the real value in a gitignored `.env.local` file, never here.
GITHUB_TOKEN=
GITHUB_REPOSITORY=activitypods/shapes
GITHUB_BASE_BRANCH=master
