PREFIX : <>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX g1: <https://portejunes.com/ns/core#>

:WalletSecret
  a sh:NodeShape ;
  sh:targetClass g1:WalletSecret ;
  sh:property [
    sh:path g1:address ;
    sh:name "address" ;
    sh:description "Public address of the wallet on the Ğ1 blockchain."@en, "Adresse publique du portefeuille sur la blockchain Ğ1."@fr ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path g1:seed ;
    sh:name "seed" ;
    sh:description "Secret seed from which the wallet's keys are derived. Never share it."@en, "Graine secrète dont sont dérivées les clés du portefeuille. À ne jamais partager."@fr ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
  ] .
