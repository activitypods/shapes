PREFIX : <>
PREFIX st: <http://www.w3.org/ns/shapetrees#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX vcard: <http://www.w3.org/2006/vcard/ns#>

:Group
  a st:ShapeTree ;
  st:expectsType st:Resource ;
  st:shape <../../shapes/vcard/Group> ;
  st:describesInstance vcard:label ;
  skos:prefLabel "Groups"@en, "Groupes"@fr ;
  skos:definition "A group of contacts defined by the user to organize their network."@en, "Un groupe de contacts défini par l'utilisateur pour organiser son réseau."@fr .
