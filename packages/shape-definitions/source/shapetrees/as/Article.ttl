PREFIX : <>
PREFIX st: <http://www.w3.org/ns/shapetrees#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX as: <https://www.w3.org/ns/activitystreams#>

:Article
  a st:ShapeTree ;
  st:expectsType st:Resource ;
  st:shape <../../shapes/as/Article> ;
  skos:prefLabel "Articles"@en, "Articles"@fr ;
  skos:definition "A long, structured text with a title and an HTML content."@en, "Un texte long et structuré, avec un titre et un contenu HTML."@fr .
