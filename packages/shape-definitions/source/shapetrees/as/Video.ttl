PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX as: <https://www.w3.org/ns/activitystreams#>

:Note
  a st:ShapeTree ;
  st:expectsType st:Resource ;
  st:shape <../../shapes/as/Video> ;
  skos:prefLabel "Videos"@en, "Vidéos"@fr ;
  skos:definition "A video and its metadata (name, duration, media type, file URL)."@en, "Une vidéo et ses métadonnées (nom, durée, type MIME, URL du fichier)."@fr .
