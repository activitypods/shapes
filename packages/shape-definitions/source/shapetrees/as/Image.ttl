PREFIX : <>
PREFIX st: <http://www.w3.org/ns/shapetrees#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX as: <https://www.w3.org/ns/activitystreams#>

:Image
  a st:ShapeTree ;
  st:expectsType st:Resource ;
  st:shape <../../shapes/as/Image> ;
  skos:prefLabel "Images"@en, "Images"@fr ;
  skos:definition "An image and its metadata (name, media type, file URL)."@en, "Une image et ses métadonnées (nom, type MIME, URL du fichier)."@fr .
