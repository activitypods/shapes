PREFIX : <>
PREFIX st: <http://www.w3.org/ns/shapetrees#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX as: <https://www.w3.org/ns/activitystreams#>
PREFIX vcard: <http://www.w3.org/2006/vcard/ns#>

:Profile
  a st:ShapeTree ;
  st:expectsType st:Resource ;
  st:shape <../../shapes/as/Profile> ;
  st:describesInstance vcard:given-name ;
  skos:prefLabel "Profiles"@en, "Profils"@fr ;
  skos:definition "The public profile of a user: name, picture, short bio. Every Pod holds one."@en, "Le profil public d'un utilisateur : nom, photo, courte présentation. Chaque Pod en contient un."@fr .
