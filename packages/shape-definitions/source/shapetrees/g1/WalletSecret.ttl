PREFIX : <>
PREFIX st: <http://www.w3.org/ns/shapetrees#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX g1: <https://portejunes.com/ns/core#>

:WalletSecret
  a st:ShapeTree ;
  st:expectsType st:Resource ;
  st:shape <../../shapes/g1/WalletSecret> ;
  st:describesInstance g1:address ;
  skos:prefLabel "Ğ1 wallet secret"@en, "Clé du portefeuille Ğ1"@fr ;
  skos:definition "The secret of a Ğ1 (libre currency) wallet, identified by its address. Sensitive data, restricted access."@en, "Le secret d'un portefeuille Ğ1 (monnaie libre), identifié par son adresse. Données sensibles, accès restreint."@fr .
